# The environment-variable contract this application reads. Every name below is
# referenced by application.yml.
#
# FOR CI AND PRODUCTION. Export these, or set them as your platform's secrets.
#
# NOT FOR LOCAL DEVELOPMENT, and copying this to .env on its own does nothing: Spring
# Boot has no .env support, so the file is inert unless something else exports it.
# Use src/main/resources/application-local.example.yml instead — copy it to
# application-local.yml (git-ignored) and run with the 'local' profile:
#
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# This file is still the reference for what a deployment must supply, and the format
# Docker Compose expects if the project grows one.

DB_URL=jdbc:postgresql://localhost:5432/carparts
DB_USER=carparts_app
DB_PASSWORD=

# HS256 signing key for JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# Passwords for the demo accounts V6__seed_demo_data.sql creates. Store the BCrypt
# digest, never the password itself — the digest is what goes in the database.
#
# Both are REQUIRED. V6 runs on every start-up, and leaving these unset fails the
# migration on ck_app_user_password_hashed rather than seeding a guessable account.
#
# Cost must be 12 and the result exactly 60 characters.
#
# Generate one with Python:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt(12, prefix=b'2a')).decode())"
#
# or with Apache htpasswd:
#   htpasswd -bnBC 12 "" YOUR-PASSWORD | tr -d ':\n'
#
# Wrap the value in single quotes: a BCrypt digest contains $ signs, which most shells
# would otherwise try to expand.
#
# SEED_ADMIN_PASSWORD_HASH covers the 'admin' and 'svc-reporting' accounts.
# SEED_STAFF_PASSWORD_HASH covers 'layla', 'omar' and 'rana'.
SEED_ADMIN_PASSWORD_HASH=
SEED_STAFF_PASSWORD_HASH=
