                <mxCell id="n1" value="Address is @Embeddable: city/street columns live on department, employee and supplier rather than in a table of their own." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="940" width="180" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="Department uses @Inheritance(JOINED): one department table plus warehouse and branch child tables sharing its primary key.  An employee therefore holds a single Department reference, and which subtype it resolves to is what makes them sales staff or warehouse staff — no role field required.  AppUser.employee is optional in both directions: a login may belong to nobody on the payroll (a service account), and staff may have no login. It is unique, so one person never holds two accounts.  There is no MANAGER role. A manager is the Employee a Department points at, so is_manager is derived at login rather than stored — one fact, one place, nothing to drift out of step." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="430" width="340" height="330" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>